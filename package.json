{
  "name": "dsh-consumer-insight",
  "version": "0.1.0",
  "description": "消费者洞察工作台：填项目目标与调研类型，生成问卷、分析框架、抽样配额与 Word/Excel 交付物。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./docs/DETAIL.md": "./docs/DETAIL.md"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/images",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "consumer-insight",
    "market-research",
    "questionnaire"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poweredbyai/dsh-consumer-insight.git"
  },
  "homepage": "https://github.com/poweredbyai/dsh-consumer-insight#readme",
  "bugs": {
    "url": "https://github.com/poweredbyai/dsh-consumer-insight/issues"
  },
  "author": "poweredbyai",
  "license": "MIT"
}
